# ============================================================
# Boiska Poznań — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ----- Frontend (Next.js public vars) -----
# Mapbox public token — get from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# URL of the FastAPI backend (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----- Supabase -----
# Project URL — e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Public anon key (safe for frontend)
SUPABASE_ANON_KEY=

# Service role key (backend + scraper ONLY, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# ----- Google Places API -----
# Required only for the scraper. Get from https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- Backend CORS -----
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000
