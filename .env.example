# ============================================================
# Boiska Poznań — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ----- Frontend (Next.js public vars — safe for browser) -----
# Mapbox public token — get from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# URL of the FastAPI backend (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL — e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public anon key (safe for frontend — subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Backend / Scraper only (NEVER expose to frontend) -----
# Project URL (same value as NEXT_PUBLIC_SUPABASE_URL but kept separate)
SUPABASE_URL=

# Anon key for backend
SUPABASE_ANON_KEY=

# Service role key — full DB access, backend + scraper ONLY
SUPABASE_SERVICE_ROLE_KEY=

# ----- Google Places API -----
# Required only for the scraper. Get from https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- Backend CORS -----
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000
