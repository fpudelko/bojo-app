# ============================================================
# Boiska Poznań — Backend Environment Variables
# Copy to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ----- Supabase -----
# Project URL — e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Public anon key (used for general queries, subject to RLS)
SUPABASE_ANON_KEY=

# Service role key — bypasses RLS; use ONLY in backend/scraper
SUPABASE_SERVICE_ROLE_KEY=

# ----- Google Places API -----
# Used by the scraper to fetch field data
GOOGLE_PLACES_API_KEY=

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- CORS -----
# Comma-separated list of allowed origins for the CORS middleware
ALLOWED_ORIGINS=http://localhost:3000
